# ── Required ────────────────────────────────────────────────────────────────
# Your bot token from @BotFather (https://t.me/BotFather)
# The HTTP server starts WITHOUT it (so your deploy never fails on a port check)
# and the bot connects the moment this is set — see /healthz and /ready.
BOT_TOKEN=

# ── Identity (optional) ─────────────────────────────────────────────────────
# Both auto-detected from getMe when empty. BOT_NAME rewrites the bot's display
# name in Telegram, so leave it empty unless you really mean it.
BOT_USERNAME=
BOT_NAME=
# Set to 0 to stop the bot writing its own name/description/commands to BotFather
SET_PROFILE=1
BOT_DESCRIPTION=
BOT_SHORT_DESCRIPTION=

# ── Transport ───────────────────────────────────────────────────────────────
# The server ALWAYS listens on 0.0.0.0:$PORT (PaaS health probes need it).
PORT=3000
HOST=0.0.0.0

# longpoll (default, works everywhere) | auto (use the platform's public domain
# if one is detected) | force (require WEBHOOK_URL)
WEBHOOK_MODE=longpoll
# Explicit public HTTPS base URL, e.g. https://yoribot.up.railway.app
WEBHOOK_URL=
# Optional: override the webhook path (default /telegram/<hash-of-token>)
WEBHOOK_PATH=
# Optional: if empty, a stable secret is derived from BOT_TOKEN and used for both
# setWebhook and request verification.
WEBHOOK_SECRET=
# Drop updates that arrived while the bot was offline, on webhook registration
WEBHOOK_DROP_PENDING=0
POLL_TIMEOUT=30

# ── Channels & admins ───────────────────────────────────────────────────────
# Public channel for /wall confessions. The bot must be an admin with
# "Post messages" rights. Accepts @username or -100… ids.
CHANNEL_ID=
# Your Telegram user id(s), comma separated. Receives abuse reports + /admin.
ADMIN_ID=

# ── Rendering ───────────────────────────────────────────────────────────────
# Bot API 10.1 Rich Messages (native tables/headings, 32 KB).
# off (default) | auto | on.  Kept off by default because some clients —
# notably Telegram Web — still render rich messages as "not supported".
RICH_MESSAGES=off
TYPING_INDICATORS=1
# Bot API 10.0 guest mode (@-mention the bot in chats it isn't a member of).
# Needs Guest Mode enabled in @BotFather; harmless when it isn't.
ALLOW_GUEST_MODE=1

# ── Anti-abuse ──────────────────────────────────────────────────────────────
GLOBAL_PER_HOUR=80
PAIR_PER_HOUR=40
WHISPER_PER_HOUR=40
MIN_INTERVAL_MS=1200
MAX_WHISPER_LENGTH=3500
MAX_WHISPER_TARGETS=5
# Extra banned phrases for the abuse filter (comma separated, lowercase)
BANNED_WORDS=

# ── Whispers ────────────────────────────────────────────────────────────────
# Default lifetime of a locked whisper card (ms). 7 days by default.
WHISPER_TTL_MS=604800000
# How often expired whispers / auto-burn messages are swept (ms)
SWEEP_INTERVAL_MS=30000

# ── Storage ─────────────────────────────────────────────────────────────────
# JSON file (atomic + debounced writes). Mount a volume here in production,
# otherwise data is lost when the container is replaced.
WHISPER_DATA=
SAVE_DEBOUNCE_MS=400

# ── Ops ─────────────────────────────────────────────────────────────────────
# silent | error | warn | info | debug
LOG_LEVEL=info
# Set to 1 for per-call API traces from the Telegram library
# DEBUG=node-telegram-bot-api:*
# Set to 1 to log every swallowed best-effort failure (reactions, edits…)
DEBUG_BOT=0

# Required: your bot token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=

# Optional: fallback username (auto-detected from getMe otherwise)
BOT_USERNAME=WHoevenYori

# Optional: public channel username or id for the /wall confession feature.
# The bot must be an admin of that channel with "Post messages" rights.
CHANNEL_ID=

# Optional: your Telegram user id — receives abuse reports from /report
ADMIN_ID=

# Optional: extra banned phrases for the abuse filter (comma separated, lowercase)
BANNED_WORDS=

# Webhook mode (leave BOTH empty to use long-polling, which works everywhere)
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=3000

# Anti-abuse rate limits
GLOBAL_PER_HOUR=80
PAIR_PER_HOUR=40
MIN_INTERVAL_MS=1200

# Where to store data (JSON file). Leave empty for the default ./data/whisper.json
WHISPER_DATA=
